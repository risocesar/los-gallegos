<script>
  function togglePasswordVisibility() {
    const passwordInput = document.getElementById('userPassword');
    const eyeIcon = document.getElementById('passwordEyeIcon');
    if (!passwordInput || !eyeIcon) return;

    if (passwordInput.type === 'password') {
      passwordInput.type = 'text';
      eyeIcon.textContent = 'visibility_off';
    } else {
      passwordInput.type = 'password';
      eyeIcon.textContent = 'visibility';
    }
  }

  function showContactModal() {
    const modal = document.getElementById('contactModal');
    if (modal) modal.classList.remove('hidden');
  }

  function closeContactModal() {
    const modal = document.getElementById('contactModal');
    if (modal) modal.classList.add('hidden');
  }

  function showTermsModal() {
    const modal = document.getElementById('termsModal');
    if (modal) modal.classList.remove('hidden');
  }

  function closeTermsModal() {
    const modal = document.getElementById('termsModal');
    if (modal) modal.classList.add('hidden');
  }

  function showAlert(message) {
    const alertBox = document.getElementById('authAlert');
    const alertText = document.getElementById('authAlertText');
    if (alertBox && alertText) {
      alertText.textContent = message;
      alertBox.classList.remove('hidden');
    }
  }

  function hideAlert() {
    const alertBox = document.getElementById('authAlert');
    if (alertBox) alertBox.classList.add('hidden');
  }

  function setButtonLoading(loading) {
    const btn = document.getElementById('submitButton');
    const icon = document.getElementById('buttonIcon');
    const text = document.getElementById('buttonText');
    const spinner = document.getElementById('buttonSpinner');
    if (!btn) return;

    if (loading) {
      btn.disabled = true;
      if (icon) icon.classList.add('hidden');
      if (spinner) spinner.classList.remove('hidden');
      if (text) text.textContent = 'Verificando credenciales...';
    } else {
      btn.disabled = false;
      if (icon) icon.classList.remove('hidden');
      if (spinner) spinner.classList.add('hidden');
      if (text) text.textContent = 'Iniciar Sesión en el CRM';
    }
  }

  async function handleLoginSubmit(event) {
    event.preventDefault();
    hideAlert();

    const emailInput = document.getElementById('userEmail');
    const passInput = document.getElementById('userPassword');
    const email = emailInput ? emailInput.value.trim() : '';
    const password = passInput ? passInput.value : '';

    if (!email || !password) {
      showAlert('Por favor complete todos los campos requeridos para acceder.');
      return;
    }

    setButtonLoading(true);

    try {
      const client = window.supabaseInstance;

      if (!client) {
        throw new Error('El servicio de autenticación no se encuentra disponible.');
      }

      const { data, error } = await client.auth.signInWithPassword({
        email: email,
        password: password
      });

      if (error) {
        throw error;
      }

      const user = data?.user;
      if (!user) {
        throw new Error('No se pudo verificar el usuario autenticado.');
      }

      // Consultar tabla perfiles_usuarios para verificar rol y estado activo
      const { data: perfil, error: perfilError } = await client
        .from('perfiles_usuarios')
        .select('*')
        .eq('id', user.id)
        .maybeSingle();

      if (perfilError) {
        console.warn('Error al verificar perfil de usuario:', perfilError);
      }

      if (perfil && perfil.activo === false) {
        await client.auth.signOut();
        throw new Error('Su usuario se encuentra inactivo. Comuníquese con la administración.');
      }

      const userRole = (perfil?.rol || user?.user_metadata?.rol || user?.user_metadata?.role || '').toLowerCase();

      const usuarioActivo = {
        id: user.id,
        email: user.email,
        nombre: perfil?.nombre_completo || perfil?.nombre || user?.user_metadata?.nombre || user.email,
        rol: userRole || (email.toLowerCase().includes('tecnico') ? 'tecnico_campo' : 'administrador'),
        fecha_ingreso: new Date().toISOString()
      };

      try {
        localStorage.setItem('usuario_activo', JSON.stringify(usuarioActivo));
      } catch (e) {
        console.warn(e);
      }

      if (userRole === 'tecnico_campo' || userRole === 'tecnico' || (!userRole && email.toLowerCase().includes('tecnico'))) {
        window.location.href = 'agenda.html';
      } else {
        window.location.href = 'direcciones.html';
      }
    } catch (err) {
      setButtonLoading(false);
      const errorMsg = err?.message || 'Credenciales no reconocidas o usuario no habilitado en el sistema.';
      showAlert('Error de autenticación: ' + errorMsg);
    }
  }
